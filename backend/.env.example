# Supabase Configuration (Database BaaS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Short URL Domain (Where short links are hosted and redirected)
# In development: http://localhost:8000
# In production: https://your-backend.vercel.app
SHORT_BASE_URL=http://localhost:8000

# Frontend Origin for CORS validation
# In development: http://localhost:3000
# In production: https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
